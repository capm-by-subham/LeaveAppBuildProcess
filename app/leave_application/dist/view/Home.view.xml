<mvc:View
    xmlns:cards="sap.f.cards"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    controllerName="leaveapplication.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
>
    <Page id="page"
        title="{i18n>title}"
        titleAlignment="Start">
        <headerContent>
            <Button text="Save"
                press=".onSave" />
        </headerContent>
        <FlexBox>
            <VBox width="100%">
                <f:Card>
                    <f:content>
                        <Panel expandable="true" headerText="Allocated Leaves" width="100%">
                            <content>
                                <Table id="idLeaveAllocation"
                                    items="{/LeaveAllocations}"
                                    growing="true"
                                    noDataText="No leave allocations found">
                                    <columns>
                                        <Column>
                                            <Text text="Leave Type" />
                                        </Column>
                                        <Column hAlign="End">
                                            <Text text="Total Allocated Leaves" />
                                        </Column>
                                        <Column hAlign="End"
                                            minScreenWidth="Tablet"
                                            demandPopin="true">
                                            <Text text="Expired Leaves" />
                                        </Column>
                                        <Column hAlign="End"
                                            minScreenWidth="Tablet"
                                            demandPopin="true">
                                            <Text text="Used Leaves" />
                                        </Column>
                                        <Column hAlign="End"
                                            minScreenWidth="Tablet"
                                            demandPopin="true">
                                            <Text text="Leaves Pending Approval" />
                                        </Column>
                                        <Column hAlign="End">
                                            <Text text="Available Leaves" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{leaveType}" />
                                                <ObjectNumber number="{totalAllocated}" />
                                                <ObjectNumber number="{expired}" />
                                                <ObjectNumber number="{used}" />
                                                <ObjectNumber number="{pendingApproval}"
                                                    state="Warning" />
                                                <ObjectNumber number="{available}"
                                                    state="Success"
                                                    emphasized="true" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </content>
                        </Panel>
                    </f:content>
                </f:Card>
                <f:Card>
                    <f:content>
                        <form:Form id="idLeaveApplyForm" editable="true">
                            <form:layout>
                                <form:ColumnLayout columnsXL="3"
                                    columnsL="3"
                                    columnsM="2"
                                    labelCellsLarge="12"
                                    emptyCellsLarge="0" />
                            </form:layout>
                            <form:formContainers>

                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Series">
                                            <form:fields>
                                                <Select selectedKey="{Leave>/LeaveRequest/series}"
                                                    required="true">
                                                    <core:Item key="HR-LAP-.YYYY.-"
                                                        text="HR-LAP-.YYYY.-" />
                                                </Select>
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Employee">
                                            <form:fields>
                                                <Input value="{Leave>/LeaveRequest/employeeId}"
                                                    required="true" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Employee Name">
                                            <form:fields>
                                                <Input value="{Leave>/LeaveRequest/employeeName}"
                                                    editable="false" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>

                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Leave Type">
                                            <form:fields>
                                                <Select
                                                    selectedKey="{Leave>/LeaveRequest/leaveType}"
                                                    items="{/LeaveAllocations}"
                                                    forceSelection="false"
                                                    required="true">
                                                    <core:Item key="{leaveType}" text="{leaveType}" />
                                                </Select>
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Company">
                                            <form:fields>
                                                <Input value="{Leave>/LeaveRequest/company}"
                                                    required="true" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Reporting Manager">
                                            <form:fields>
                                                <Input
                                                    value="{Leave>/LeaveRequest/reportingManager}"
                                                    editable="false" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>

                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Department">
                                            <form:fields>
                                                <Input value="{Leave>/LeaveRequest/department}"
                                                    editable="false" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Sub Department">
                                            <form:fields>
                                                <Input value="{Leave>/LeaveRequest/subDepartment}"
                                                    editable="false" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>

                            </form:formContainers>
                        </form:Form>
                    </f:content>
                </f:Card>
                <f:Card>
                    <f:header>
                        <cards:Header title="Dates &amp; Reason" />
                    </f:header>
                    <f:content>
                        <form:Form id="idDatendReason" editable="true">
                            <form:layout>
                                <form:ColumnLayout columnsXL="2" columnsL="2" columnsM="2"
                                    labelCellsLarge="12" emptyCellsLarge="0" />
                            </form:layout>
                            <form:formContainers>

                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="From Date">
                                            <form:fields>
                                                <DatePicker valueFormat="yyyy-MM-dd"
                                                    displayFormat="dd-MM-yyyy"
                                                    value="{Leave>/dateReason/from}"
                                                    required="true" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="To Date">
                                            <form:fields>
                                                <DatePicker valueFormat="yyyy-MM-dd"
                                                    displayFormat="dd-MM-yyyy"
                                                    value="{Leave>/dateReason/to}"
                                                    required="true" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement>
                                            <form:fields>
                                                <CheckBox text="Half Day"
                                                    selected="{Leave>/dateReason/halfDay}" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>

                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Reason">
                                            <TextArea value="{Leave>/dateReason/reason}"
                                                required="true"></TextArea>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>


                            </form:formContainers>
                        </form:Form>
                    </f:content>
                </f:Card>
                <f:Card>
                    <f:header>
                        <cards:Header title="Approval" />
                    </f:header>
                    <f:content>
                        <form:Form id="idApproval" editable="false">
                            <form:layout>
                                <form:ColumnLayout columnsXL="2" columnsL="2" columnsM="2"
                                    labelCellsLarge="12" emptyCellsLarge="0" />
                            </form:layout>
                            <form:formContainers>

                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Leave Approver">
                                            <form:fields>
                                                <Input
                                                    value="{Leave>/approval/from}"
                                                    required="true" editable="false" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement label="Leave Approver Name">
                                            <form:fields>
                                                <Input
                                                    value="{Leave>/approval/name}"
                                                    required="true" editable="false" />
                                            </form:fields>
                                        </form:FormElement>
                                        <form:FormElement>
                                            <form:fields>
                                                <CheckBox text="Follow via Email"
                                                    selected="{Leave>/approval/viaEmail}" />
                                            </form:fields>
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>

                                <form:FormContainer>
                                    <form:formElements>
                                        <form:FormElement label="Posting Date">
                                            <DatePicker valueFormat="yyyy-MM-dd"
                                                displayFormat="dd-MM-yyyy"
                                                value="{Leave>/approval/postDate}"
                                                required="true" />
                                        </form:FormElement>
                                    </form:formElements>
                                </form:FormContainer>


                            </form:formContainers>
                        </form:Form>
                    </f:content>
                </f:Card>
            </VBox>
        </FlexBox>
    </Page>
</mvc:View>